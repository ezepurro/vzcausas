# Servidor
PORT=3000
NODE_ENV=development

# JWT (D-04, D-06)
JWT_ACCESS_SECRET=change-me-to-32-random-bytes-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# bcrypt (D-07)
BCRYPT_COST=12

# Cookie de refresh (D-08, Q-06)
COOKIE_REFRESH_NAME=refresh_token
COOKIE_REFRESH_PATH=/api/v1/auth
COOKIE_REFRESH_SAMESITE=Lax
COOKIE_SECURE=false

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Zona horaria del estudio (ARQUITECTURA_BACKEND_V1.md §7.7)
APP_TIMEZONE=America/Argentina/Cordoba
