# Servidor
PORT=3000
NODE_ENV=development

# Base de datos. Estas credenciales son las de desarrollo del
# docker-compose del proyecto (ver docker/.env.example) — no son
# secretas. Corriendo `npm run start:dev` fuera de Docker, este valor
# conecta al Postgres publicado en localhost:5432.
DATABASE_URL=postgresql://causas-dev:causas-dev@localhost:5432/causas-dev

# JWT del access token. El valor de ejemplo NO es un secreto real:
# generar uno propio de al menos 32 bytes aleatorios para cualquier
# entorno que no sea desarrollo local (nunca reutilizar este valor).
JWT_ACCESS_SECRET=change-me-to-32-random-bytes-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Costo de hashing de contraseñas
BCRYPT_COST=12

# Cookie de refresh. SameSite=None exige COOKIE_SECURE=true:
# el navegador descarta la cookie en caso contrario.
COOKIE_REFRESH_NAME=refresh_token
COOKIE_REFRESH_PATH=/api/v1/auth
COOKIE_REFRESH_SAMESITE=Lax
COOKIE_SECURE=false

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Zona horaria del estudio: rige el cálculo de plazos y el formato
# de las fechas que devuelve la API.
APP_TIMEZONE=America/Argentina/Cordoba

# Usuario sembrado al arrancar. Opcionales: si faltan no se siembra
# nadie y el login rechaza toda credencial. Solo tienen efecto con
# NODE_ENV=development; en cualquier otro entorno se ignoran. El valor
# de ejemplo es apto para desarrollo local, nunca para un entorno real.
DEV_SEED_USERNAME=admin
DEV_SEED_PASSWORD=admin123
