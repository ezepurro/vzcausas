# Servidor
PORT=3000
NODE_ENV=development

# Base de datos. Estas credenciales son las de desarrollo del
# docker-compose del proyecto (ver docker/.env.example) — no son
# secretas. Corriendo `npm run start:dev` fuera de Docker, este valor
# conecta al Postgres publicado en localhost:5432.
DATABASE_URL=postgresql://causas-dev:causas-dev@localhost:5432/causas-dev

# JWT del access token. El valor de ejemplo NO es un secreto real:
# generar uno propio de al menos 32 bytes aleatorios para cualquier
# entorno que no sea desarrollo local (nunca reutilizar este valor).
JWT_ACCESS_SECRET=change-me-to-32-random-bytes-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Costo de hashing de contraseñas
BCRYPT_COST=12

# Cookie de refresh. SameSite=None exige COOKIE_SECURE=true:
# el navegador descarta la cookie en caso contrario.
COOKIE_REFRESH_NAME=refresh_token
COOKIE_REFRESH_PATH=/api/v1/auth
COOKIE_REFRESH_SAMESITE=Lax
COOKIE_SECURE=false

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Zona horaria del estudio: rige el cálculo de plazos y el formato
# de las fechas que devuelve la API.
APP_TIMEZONE=America/Argentina/Cordoba

# ─────────────────────────────────────────────────────────────
# Bloqueo progresivo por intentos fallidos de login (Q-03)
# ─────────────────────────────────────────────────────────────
#
# Dos capas, porque ninguna sola alcanza:
#
#   LOGIN_LOCK_*       cuenta por usuario + dirección IP. Es el
#                      bloqueo principal. Acotado a la IP para que
#                      un desconocido no pueda dejar afuera a un
#                      abogado de su propia cuenta fallando a
#                      propósito.
#   LOGIN_LOCK_USER_*  cuenta por usuario solo, con umbral alto. Es
#                      la red de contención para el ataque
#                      distribuido, que la capa anterior no ve: cien
#                      máquinas fallando cuatro veces cada una son
#                      cuatrocientos intentos contra una cuenta sin
#                      que ningún par (usuario, IP) llegue a cinco.
#
# _THRESHOLD  entero. Se bloquea en cada múltiplo de este número de
#             fallos consecutivos.
# _WINDOW     los fallos más viejos que esto se olvidan. Se cuenta
#             desde que terminó el bloqueo anterior, no desde el
#             último fallo.
# _LADDER     duración del bloqueo por nivel, separadas por comas. El
#             último escalón se repite para siempre, así que es el
#             tope: sin tope, cualquiera que sepa un nombre de
#             usuario podría mantener esa cuenta cerrada
#             indefinidamente.
#
# Formato de las duraciones: <número><s|m|h|d>, el mismo de JWT_*_TTL.
# Un valor mal escrito corta el arranque con el nombre de la variable.
LOGIN_LOCK_THRESHOLD=5
LOGIN_LOCK_WINDOW=15m
LOGIN_LOCK_LADDER=90s,5m,15m,30m,60m

LOGIN_LOCK_USER_THRESHOLD=25
LOGIN_LOCK_USER_WINDOW=1h
LOGIN_LOCK_USER_LADDER=15m

# ─────────────────────────────────────────────────────────────
# Inactividad de sesión (CA-1.6)
# ─────────────────────────────────────────────────────────────
#
# Cuánto puede estar una sesión sin renovarse antes de que el access
# token deje de aceptarse. Se cuenta desde la última renovación real
# (cada vez que el cliente pide un access token nuevo), no desde el
# login: mientras el usuario sigue usando la app, eso pasa como mínimo
# cada JWT_ACCESS_TTL.
#
# Es una expiración APROXIMADA, no al segundo: como solo se actualiza
# en cada renovación, una sesión puede quedar viva hasta
# SESSION_INACTIVITY_TTL + JWT_ACCESS_TTL después del último uso real,
# en vez de cortarse justo a los 30 minutos. A cambio, no cuesta una
# escritura por cada petición autenticada — se decidió así a propósito.
#
# Se aplica en dos lugares con el MISMO valor (no es redundancia, es
# necesario): al verificar el access token en cada petición, y al
# intentar renovar con /auth/refresh. Si sólo se aplicara en el primero,
# la renovacion automatica y silenciosa del frontend revive la
# sesion inactiva en el instante en que el access token empieza a
# fallar, y esta regla nunca se notaria.
SESSION_INACTIVITY_TTL=30m

# ─────────────────────────────────────────────────────────────
# Throttle por IP (Q-03)
# ─────────────────────────────────────────────────────────────
#
# Es distinto del bloqueo de LOGIN_LOCK_* de arriba: ese cuenta
# contrasenas erradas contra UNA cuenta; esto cuenta pedidos desde UNA
# direccion IP, sin importar a que cuenta apunten ni a que endpoint.
# Hace falta el segundo porque el primero es ciego al volumen: alguien
# probando una sola contrasena contra 200 usuarios distintos deja un
# solo fallo por cuenta (nunca llega al umbral de 5), pero son 200
# pedidos desde una sola IP en segundos.
#
# THROTTLE_DEFAULT_* rige TODA la API (generoso, pensado para no
# molestar a nadie en uso normal). THROTTLE_AUTH_* reemplaza ese limite
# SOLO en /auth/login y /auth/refresh (mas estricto, porque ahi un
# intento fallido cuesta ademas un hash de bcrypt).
#
# Formato de las ventanas: igual al de JWT_*_TTL.
THROTTLE_DEFAULT_LIMIT=300
THROTTLE_DEFAULT_WINDOW=1m
THROTTLE_AUTH_LIMIT=10
THROTTLE_AUTH_WINDOW=1m

# Si el backend corre detras de un proxy (el de Vite en dev, nginx u
# otro balanceador en produccion), hay que decirle a Express que confie
# en el encabezado X-Forwarded-For para que req.ip sea la IP real del
# cliente y no la del proxy. SIN esto detras de un proxy, el throttle
# y el bloqueo de login cuentan a TODOS los usuarios como si fueran
# uno solo (comparten el balde de la IP del proxy). CON esto SIN un
# proxy real adelante, cualquiera puede falsificar el encabezado y
# saltarse el limite por completo.
#
# Vacio o sin definir: no confia en el encabezado (seguro por
# defecto). "1": confia en el primer salto (alcanza para el proxy de
# Vite y para la mayoria de los despliegues de un solo balanceador).
# Para topologias mas finas, ver los valores que acepta Express en
# "trust proxy".
TRUST_PROXY=

# Usuario sembrado al arrancar. Opcionales: si faltan no se siembra
# nadie y el login rechaza toda credencial. Solo tienen efecto con
# NODE_ENV=development; en cualquier otro entorno se ignoran. El valor
# de ejemplo es apto para desarrollo local, nunca para un entorno real.
DEV_SEED_USERNAME=admin
DEV_SEED_PASSWORD=admin123

# ─────────────────────────────────────────────────────────────
# Google OAuth (ADR-004_EMAIL_GMAIL_API.md §2.1/§2.3, N-10 en
# IMPLEMENTACION_NOTIFICACIONES.md)
# ─────────────────────────────────────────────────────────────
#
# Cliente único y compartido en shared/, con los scopes drive.file +
# gmail.send pedidos juntos en una sola autorización — no es un cliente
# propio de `deadlines` ni de `documents`.
#
# Se obtienen corriendo `npm run google:authorize` (backend/scripts/
# google-authorize.ts) con un proyecto de Google Cloud propio de
# desarrollo. Los valores de ejemplo NO son reales: nunca pegues acá
# tu client_id/secret/refresh_token verdaderos, este archivo se
# commitea.
GOOGLE_OAUTH_CLIENT_ID=change-me.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=change-me
GOOGLE_OAUTH_REFRESH_TOKEN=change-me
# Casilla de gestión del estudio (RNF 5); en desarrollo, tu propia
# cuenta de Gmail de prueba, la misma que autorizaste.
MANAGEMENT_MAILBOX=change-me@gmail.com
# D-79: si además se manda copia al abogado responsable de cada causa.
# Opcional — sin definir, se comporta como "true" (el default del
# contrato). Poné "false" para apagarlo sin tocar código.
COPY_TO_RESPONSIBLE_LAWYER=true
# D-79: días hábiles de preaviso de un vencimiento (HU51). Opcional — sin
# definir vale 3 (el default del contrato). Entero mayor o igual a 1.
DEADLINE_WARNING_BUSINESS_DAYS=3

# ─────────────────────────────────────────────────────────────
# Carpeta de cada causa en Google Drive (HU39, ADR-003, ADR-005)
# ─────────────────────────────────────────────────────────────
#
# Con las tres GOOGLE_OAUTH_* cargadas con valores reales, `documents` usa
# Google Drive. Sin ellas (o con los `change-me` de arriba), usa un
# almacenamiento EN MEMORIA que se pierde al reiniciar; en producción la
# aplicación no arranca así.
#
# Primera vez en un entorno, con las tres cargadas:
#   npm run google:authorize          (si todavía no tenés el refresh token)
#   npm run documents:setup-storage   (crea "VZ Causas", "Modelos formales" y "Causas")
#
# Las dos son opcionales; sin definir, valen lo que dice acá.
#
# Tiempo máximo de cada llamada a Drive, en milisegundos.
# DRIVE_REQUEST_TIMEOUT_MS=15000
# Cuánto espera el alta de una causa a que su carpeta esté lista, en
# milisegundos. Si se agota, la respuesta trae la carpeta en CREATING y la
# creación sigue en segundo plano.
# CASE_FOLDER_WAIT_MS=10000

# ─────────────────────────────────────────────────────────────
# Disparo diario de HU30/HU32 (N-04, R-01 opción c,
# .github/workflows/deadlines-daily-run.yml)
# ─────────────────────────────────────────────────────────────
#
# Secreto que valida POST /internal/deadlines/daily-run — no es
# auth de usuario, es el header que GitHub Actions manda. Mismo
# valor que el secreto de repo INTERNAL_TRIGGER_SECRET en GitHub
# (Settings > Secrets and variables > Actions). Generá el tuyo con
# algo como `openssl rand -hex 32`; el de ejemplo no sirve para nada
# real.
INTERNAL_TRIGGER_SECRET=change-me
