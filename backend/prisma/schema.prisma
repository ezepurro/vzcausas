// Modelos agrupados por subsistema, en el orden del mapa de §4.2 de
// ARQUITECTURA_BACKEND_V1.md. Regla de propiedad del dato (§4.4): cada
// subsistema escribe únicamente sus propias tablas, aunque el cliente
// de Prisma sea único y compartido.

datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// ─────────────────────────────────────────────────────────────
// identity — Identidad y Acceso (EP-01)
// ─────────────────────────────────────────────────────────────

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(50)
  fullName     String    @map("full_name") @db.VarChar(255)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  lawyerId     Int?      @map("lawyer_id")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  active       Boolean   @default(true)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  refreshTokens RefreshToken[]
  roles         UserRole[]

  // Clave foránea hacia `people`. Se admite entre subsistemas (§4.4):
  // lo que no se admite es que `identity` escriba la tabla `lawyers`.
  // `Restrict` y no `SetNull`: las bajas son lógicas (RN12), así que un
  // borrado físico no debería ocurrir nunca; si alguien lo intenta,
  // preferimos que falle ruidosamente antes que desvincular en silencio.
  //
  // Sin `@unique`: que un abogado pueda tener a lo sumo una cuenta es
  // razonable pero no está relevado — P-07 de PENDIENTE_DEFINICION.md
  // marca la obligatoriedad del vínculo como decisión del equipo sin
  // respaldo documental. No se fija esa regla en la base hasta definirla.
  lawyer Lawyer? @relation(fields: [lawyerId], references: [id], onDelete: Restrict)

  @@index([lawyerId])
  @@map("users")
}

model RefreshToken {
  // `id`, `familyId` y `replacedBy` siguen siendo UUID a propósito: son
  // identificadores opacos de rotación de sesión, no claves de negocio.
  // Ningún puerto del dominio los expone como número (ver `StoredRefresh`
  // en refresh-token-store.port.ts, que ni siquiera tiene campo `id`).
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  userId     Int       @map("user_id")
  familyId   String    @map("family_id") @db.Uuid
  replacedBy String?   @map("replaced_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replaced RefreshToken?  @relation("TokenRotation", fields: [replacedBy], references: [id], onDelete: SetNull)
  previous RefreshToken[] @relation("TokenRotation")

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId Int @map("user_id")
  roleId Int @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────────────────────
// people — Personas (EP-02)
// ─────────────────────────────────────────────────────────────

model Lawyer {
  id                 Int      @id @default(autoincrement())
  fullName           String   @map("full_name") @db.VarChar(255)
  // Matrícula del Colegio de Abogados de Córdoba: circunscripción y
  // número separados por guión (`1-28114`). El formato lo valida el
  // value object RegistrationNumber; acá solo se garantiza unicidad.
  registrationNumber String   @unique @map("registration_number") @db.VarChar(50)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users User[]

  @@map("lawyers")
}

enum DayType {
  NONE
  BUSINESS
  CONSECUTIVE
}

// ─────────────────────────────────────────────────────────────
// Legal-Parameters - Sprint 01
// ─────────────────────────────────────────────────────────────

model Jurisdiction {
  jurisdictionId Int     @id @default(autoincrement()) @map("jurisdiction_id")
  name           String  @unique
  dayTypeDefault DayType @map("day_type_default")
  isActive       Boolean @default(true) @map("is_active")
}
