// Modelos agrupados por subsistema, en el orden del mapa de §4.2 de
// ARQUITECTURA_BACKEND_V1.md. Regla de propiedad del dato (§4.4): cada
// subsistema escribe únicamente sus propias tablas, aunque el cliente
// de Prisma sea único y compartido.

datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// ─────────────────────────────────────────────────────────────
// identity — Identidad y Acceso (EP-01)
// ─────────────────────────────────────────────────────────────

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(50)
  // Apellido y nombres separados (API Contract V4, D-68).
  lastName     String    @map("last_name") @db.VarChar(100)
  firstName    String    @map("first_name") @db.VarChar(100)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  lawyerId     Int?      @map("lawyer_id")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  active       Boolean   @default(true)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  refreshTokens RefreshToken[]
  roles         UserRole[]

  // Relaciones inversas hacia `cases` (no agregan columnas a `users`).
  createdCases               Case[]            @relation("CaseCreatedBy")
  registeredProceduralActs   ProceduralAct[]   @relation("ProceduralActRegisteredBy")
  interruptiveActs           InterruptiveAct[] @relation("InterruptiveActRegisteredBy")
  // Causas que el usuario marcó como prescriptas (HU33).
  casesMarkedAsPrescribed    Case[]            @relation("CasePrescriptionRegisteredBy")
  // Causas que el usuario dio de baja (HU21).
  deactivatedCases           Case[]            @relation("CaseDeactivatedBy")
  // Actos procesales que el usuario modificó por última vez (HU28, D-98).
  lastModifiedProceduralActs ProceduralAct[]   @relation("ProceduralActLastModifiedBy")

  // Relaciones inversas hacia `documents`.
  documentTemplateVersions DocumentTemplate[]
  folderAccess             UserFolderAccess?
  // Expedientes que el usuario generó (HU25).
  generatedCaseFiles       CaseFile[]

  // Relación inversa hacia `audit_log` (HU14, HU19, HU21).
  auditEntries AuditLog[]

  // Clave foránea hacia `people`. Se admite entre subsistemas (§4.4):
  // lo que no se admite es que `identity` escriba la tabla `lawyers`.
  // `Restrict` y no `SetNull`: las bajas son lógicas (RN12), así que un
  // borrado físico no debería ocurrir nunca; si alguien lo intenta,
  // preferimos que falle ruidosamente antes que desvincular en silencio.
  //
  // Un abogado tiene como máximo una cuenta ACTIVA. La regla la
  // impone un índice único parcial que crea la migración
  // `one_active_account_per_lawyer`:
  //
  //   CREATE UNIQUE INDEX "users_lawyer_id_active_key"
  //     ON "users" ("lawyer_id")
  //     WHERE "active" = true AND "lawyer_id" IS NOT NULL;
  //
  // Es parcial y no un `@unique` porque dar de baja una cuenta libera
  // la matrícula: el abogado sigue ejerciendo y solo cambió de cuenta.
  //
  // ATENCIÓN: Prisma no sabe expresar índices parciales, así que este
  // índice no figura en el modelo y `prisma migrate dev` lo va a ver
  // como deriva. Si una migración generada trae un DROP de
  // `users_lawyer_id_active_key`, hay que quitarlo a mano.
  lawyer Lawyer? @relation(fields: [lawyerId], references: [id], onDelete: Restrict)

  @@index([lawyerId])
  @@index([lastName, firstName])
  @@map("users")
}

model RefreshToken {
  // `id`, `familyId` y `replacedBy` siguen siendo UUID a propósito: son
  // identificadores opacos de rotación de sesión, no claves de negocio.
  // Ningún puerto del dominio los expone como número (ver `StoredRefresh`
  // en refresh-token-store.port.ts, que ni siquiera tiene campo `id`).
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  userId     Int       @map("user_id")
  familyId   String    @map("family_id") @db.Uuid
  replacedBy String?   @map("replaced_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replaced RefreshToken?  @relation("TokenRotation", fields: [replacedBy], references: [id], onDelete: SetNull)
  previous RefreshToken[] @relation("TokenRotation")

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// Contador de intentos fallidos de login (Q-03). Una fila por clave
// vigilada, no un registro de cada intento: lo único que la política
// pregunta es "cuántos seguidos" y "hasta cuándo está bloqueado", y una
// fila mutable contesta las dos con un solo upsert.
//
// `identifier` es la clave compuesta que arma el adaptador
// (`u:<username>` o `u:<username>|ip:<ip>`), y NO una FK a `users`: se
// cuenta también contra usuarios inexistentes. Es deliberado — D-18
// responde lo mismo ante un usuario que no existe que ante una
// contraseña mala para que no se puedan enumerar cuentas, y un bloqueo
// que sólo existiera para usuarios reales devolvería esa distinción.
//
// No hay relación hacia `User` por el mismo motivo, así que esta tabla
// no se borra en cascada: las filas se limpian por antigüedad.
model LoginAttempt {
  identifier          String    @id @db.VarChar(120)
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  lastFailedAt        DateTime  @map("last_failed_at") @db.Timestamptz(6)
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(6)

  // Para la limpieza periódica de filas que ya no pesan en ninguna
  // decisión; la lectura del login va siempre por la clave primaria.
  @@index([lastFailedAt])
  @@map("login_attempts")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId Int @map("user_id")
  roleId Int @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────────────────────
// people — Personas (EP-02)
// ─────────────────────────────────────────────────────────────

model Lawyer {
  id                 Int      @id @default(autoincrement())
  // Apellido y nombres separados, sin el tratamiento ("Dr.", "Dra."),
  // que lo pone el frontend (D-68, D-81).
  lastName           String   @map("last_name") @db.VarChar(100)
  firstName          String   @map("first_name") @db.VarChar(100)
  // Matrícula del Colegio de Abogados de Córdoba: circunscripción y
  // número separados por guión (`1-28114`). El formato lo valida el
  // value object RegistrationNumber; acá solo se garantiza unicidad.
  // Opcional (D-107): un abogado puede no tener matrícula todavía. El
  // @unique se mantiene: PostgreSQL admite varios NULL.
  registrationNumber String?  @unique @map("registration_number") @db.VarChar(50)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users User[]

  // Relaciones inversas hacia `cases` (no agregan columnas a `lawyers`).
  responsibleCases           Case[]            @relation("CaseResponsibleLawyer")
  receivedNotifications SentNotification[]
  registeredProceduralActs   ProceduralAct[]   @relation("ProceduralActRegisteredByLawyer")
  registeredInterruptiveActs InterruptiveAct[] @relation("InterruptiveActRegisteredByLawyer")

  // Relación inversa hacia `documents`: carpetas del abogado en la nube.
  cloudFolders CloudFolder[]

  @@index([lastName, firstName])
  @@map("lawyers")
}

model Client {
  id          Int      @id @default(autoincrement())
  lastName    String   @map("last_name") @db.VarChar(100)
  firstName   String   @map("first_name") @db.VarChar(100)
  // Tipo y número de documento (D-108). El formato de cada tipo lo valida
  // un CHECK manual. Único por (tipo, número) entre los clientes VIGENTES:
  // índice único parcial `clients_document_active_key`, creado a mano.
  documentType   DocumentType @default(DNI) @map("document_type")
  documentNumber String        @map("document_number") @db.VarChar(20)
  // Obligatorios (D-109), también en la base.
  address     String   @db.VarChar(255)
  phone       String   @db.VarChar(50)
  email       String?  @db.VarChar(255)
  // Fecha civil. La asigna la aplicación con `ClockPort.today()`
  // (Córdoba), nunca `CURRENT_DATE`, que corre en la zona de la base.
  clientSince DateTime @map("client_since") @db.Date
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cases Case[]

  @@index([lastName, firstName])
  @@map("clients")
}

enum DocumentType {
  DNI
  PASSPORT

  @@map("document_type")
}

enum DayType {
  NONE
  BUSINESS
  CONSECUTIVE

  @@map("day_type")
}

// Rol procesal del cliente en la causa. Los códigos van en castellano; el
// rótulo de pantalla lo resuelve el frontend. Valores por fuero:
//   CRIMINAL:       DEFENSA, QUERELLANTE_PARTICULAR
//   ADMINISTRATIVE: DEFENSA, RECURRENTE
//   AMPARO:         ACTORA, DEMANDADA
// La correspondencia con el fuero se valida en el dominio.
enum ProceduralRole {
  DEFENSA
  QUERELLANTE_PARTICULAR
  RECURRENTE
  ACTORA
  DEMANDADA

  @@map("procedural_role")
}

// ─────────────────────────────────────────────────────────────
// Legal-Parameters - Sprint 01
// ─────────────────────────────────────────────────────────────

model Jurisdiction {
  jurisdictionId Int     @id @default(autoincrement()) @map("jurisdiction_id")
  name           String  @unique
  dayTypeDefault DayType @map("day_type_default")
  isActive       Boolean @default(true) @map("is_active")

  proceduralStates  ProceduralState[]
  cases             Case[]
  cloudFolders      CloudFolder[]
  documentTemplates DocumentTemplateJurisdiction[]

  @@map("jurisdictions")
}

// Sin `position`: los estados no tienen orden y se listan por `state_id`
// (API Contract V3, revisión del 05/10/2026, D-31).
//
// `name` es único POR FUERO y solo entre los VIGENTES, sin distinguir
// mayúsculas. Lo impone un índice único parcial creado a mano:
//
//   CREATE UNIQUE INDEX "procedural_states_jurisdiction_name_active_key"
//     ON "procedural_states" ("jurisdiction_id", lower("name"))
//     WHERE "is_active" = true;
//
// Estado inicial: `is_initial = true` marca el estado de sistema
// "Iniciada", uno por fuero (índice único parcial
// `procedural_states_one_initial_per_jurisdiction_key`). Lo crea el
// seed; la API no lo lista, no lo modifica ni lo da de baja, y no puede
// ser destino de un acto (D-34).
//
// Estado "Prescripta": `is_prescribed = true` marca el segundo estado de
// sistema, solo del fuero CRIMINAL. Es terminal, aparece en el listado,
// está protegido contra modificación y baja, y no es destino de un acto:
// la causa llega a él con "Marcar prescripta" (HU33, D-53, D-69). Lo
// crea el seed.
//
// ATENCIÓN: Prisma no expresa estos índices ni los CHECK de coherencia
// entre `time_limit_days` y `day_type`. Si una migración generada trae
// un DROP de alguno, hay que quitarlo a mano.
model ProceduralState {
  stateId       Int      @id @default(autoincrement()) @map("state_id")
  name          String
  timeLimitDays Int      @map("time_limit_days")
  dayType       DayType  @map("day_type")
  terminal      Boolean  @default(false)
  isInitial     Boolean  @default(false) @map("is_initial")
  isPrescribed  Boolean  @default(false) @map("is_prescribed")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  jurisdictionId Int          @map("jurisdiction_id")
  jurisdiction   Jurisdiction @relation(fields: [jurisdictionId], references: [jurisdictionId], onDelete: Restrict)

  // La causa y el acto referencian al estado, no copian su nombre:
  // renombrarlo se propaga. `Restrict` porque la baja es lógica.
  casesInState   Case[]          @relation("CaseCurrentState")
  proceduralActs ProceduralAct[]

  @@index([jurisdictionId])
  @@map("procedural_states")
}

model LegalQualification {
  id                 Int      @id @default(autoincrement())
  // Única entre las VIGENTES, sin distinguir mayúsculas: índice único
  // parcial `legal_qualifications_name_active_key` sobre `lower(name)`,
  // creado a mano.
  name               String   @db.VarChar(255)
  // CHECK manual: >= 1. Cada hecho (`Offense`) guarda su fecha de
  // prescripción, calculada con los meses vigentes al registrar la causa
  // o el acto interruptivo: cambiar los meses después no la recalcula.
  prescriptionMonths Int      @map("prescription_months")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  offenses Offense[]

  @@map("legal_qualifications")
}

// ─────────────────────────────────────────────────────────────
// cases — Gestión de Causas (EP-04, EP-05)
// ─────────────────────────────────────────────────────────────

model Case {
  id                  Int            @id @default(autoincrement())
  // Opcional (D-33). Si se informa, único entre las causas VIGENTES
  // (D-97, Sprint 4): la baja libera el SAC y la causa dada de baja lo
  // conserva. Lo impone un índice único parcial creado a mano en
  // `sprint4_manual_constraints`:
  //
  //   CREATE UNIQUE INDEX "cases_sac_number_active_key"
  //     ON "cases" ("sac_number")
  //     WHERE "active" = true AND "sac_number" IS NOT NULL;
  //
  // ATENCIÓN: Prisma no expresa índices parciales. Por eso el campo ya no
  // lleva `@unique` (no sirve `findUnique` por SAC: hay que usar
  // `findFirst` con `active: true`), y si una migración generada trae un
  // DROP de `cases_sac_number_active_key`, hay que quitarlo a mano.
  // CHECK manual: 8 dígitos.
  sacNumber           String?        @map("sac_number") @db.Char(8)
  caption             String         @db.VarChar(255)
  court               String?        @db.VarChar(255)
  jurisdictionId      Int            @map("jurisdiction_id")
  proceduralRole      ProceduralRole @map("procedural_role")
  instructorName      String?        @map("instructor_name") @db.VarChar(150)
  instructorPhone     String?        @map("instructor_phone") @db.VarChar(50)
  instructorExtension String?        @map("instructor_extension") @db.VarChar(20)
  // Solo ADMINISTRATIVE y AMPARO; NULL en CRIMINAL (dominio).
  counterparty        String?        @db.VarChar(255)
  subjectMatter       String?        @map("subject_matter") @db.VarChar(800)
  clientId            Int            @map("client_id")
  responsibleLawyerId Int            @map("responsible_lawyer_id")
  // Fecha de inicio de la causa en sede judicial. NULL mientras no tiene SAC
  // (D-33): obligatoria con SAC y sin SAC no se informa, así que no hay un
  // valor que inventar para esa causa.
  startDate           DateTime?      @map("start_date") @db.Date

  // Datos propios de cada fuero (D-67). Fuera de su fuero valen NULL; la
  // correspondencia con el fuero se valida en el dominio.
  // CRIMINAL: si el cliente está preso.
  clientDetained                  Boolean?  @map("client_detained")
  // AMPARO: medida cautelar y acto lesivo. Con estos datos se calcula
  // `harmfulActDeadline` al leer, mientras la causa está en "Iniciada"
  // (D-78); no se guarda historial de renovaciones.
  injunctionGranted               Boolean?  @map("injunction_granted")
  harmfulActDate                  DateTime? @map("harmful_act_date") @db.Date
  harmfulActRenews                Boolean?  @map("harmful_act_renews")
  // Días corridos entre renovaciones. Solo si `harmful_act_renews`.
  harmfulActRenewalDays           Int?      @map("harmful_act_renewal_days")
  harmfulActTermDays              Int?      @map("harmful_act_term_days")
  // BUSINESS o CONSECUTIVE; nunca NONE.
  harmfulActTermDayType           DayType?  @map("harmful_act_term_day_type")
  // ADMINISTRATIVE: fecha de agotamiento de la vía administrativa.
  administrativeRemedyExhaustedOn DateTime? @map("administrative_remedy_exhausted_on") @db.Date
  // Los tres fueros: tasa de justicia pagada (RN10).
  courtFeePaid                    Boolean   @default(false) @map("court_fee_paid")

  // Carpeta de la causa en la nube (HU39, HU40). `folder_status` hace de
  // compuerta: solo se pide la carpeta si se logra pasar a CREATING con una
  // actualización atómica, así una causa nunca tiene dos pedidos en curso.
  //   NULL      causa anterior al Sprint 3 o sin dato; se trata como PENDING.
  //   PENDING   no creada por elección del usuario.
  //   CREATING  se pidió y se espera la respuesta.
  //   CREATED   `cloud_folder_id` apunta a la carpeta de tipo CASE.
  //   ERROR     la creación falló; todavía no hay `cloud_folder_id` (D-60) y
  //             se reintenta.
  folderStatus  CaseFolderStatus? @map("folder_status")
  // Única: cada carpeta CASE pertenece a una sola causa.
  cloudFolderId String?           @unique @map("cloud_folder_id") @db.VarChar(128)

  // Declaración de prescripción (HU33). NULL mientras la causa no fue
  // marcada como prescripta; se carga una sola vez y no se revierte
  // (D-52, D-54).
  prescriptionDate               DateTime? @map("prescription_date") @db.Date
  prescriptionResolution         String?   @map("prescription_resolution") @db.VarChar(255)
  prescriptionGrounds            String?   @map("prescription_grounds") @db.VarChar(2000)
  prescriptionRegisteredByUserId Int?      @map("prescription_registered_by_user_id")
  prescriptionRegisteredAt       DateTime? @map("prescription_registered_at") @db.Timestamptz(6)

  // Estado actual: siempre hay uno. Al alta, el estado inicial
  // "Iniciada" del fuero. CHECK manual de exclusión mutua:
  //   num_nonnulls(current_state_id, current_custom_state) = 1
  currentStateId         Int?    @map("current_state_id")
  currentCustomState     String? @map("current_custom_state") @db.VarChar(255)
  // Acto que llevó la causa a su estado actual; de él sale el
  // vencimiento. NULL en el estado inicial y en "Prescripta", al que no
  // se llega por un acto (D-54). Lo
  // actualiza la misma transacción que registra el acto, solo si su
  // `act_date` es mayor o igual a la del acto vigente. Al modificar un
  // acto (HU28) se recalcula con la misma regla, y la causa puede
  // reabrirse (D-99).
  currentProceduralActId Int?    @unique @map("current_procedural_act_id")

  active              Boolean   @default(true)
  // Baja lógica (HU21, RN12, D-97). Las tres valen NULL mientras la causa
  // está vigente; con la baja se cargan cuándo y quién, y el motivo si se
  // informó (CHECK manual `ck_cases_deactivation_coherent`). Revertir una
  // baja desde la base exige volver a NULL las tres. El motivo va acá y
  // no en `audit_log` porque es texto libre que puede tener datos
  // sensibles (AUDITORIA_Y_TRAZABILIDAD.md §4).
  deactivatedAt       DateTime? @map("deactivated_at") @db.Timestamptz(6)
  deactivatedByUserId Int?      @map("deactivated_by_user_id")
  deactivationReason  String?   @map("deactivation_reason") @db.VarChar(500)

  createdByUserId Int      @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Todas `Restrict`: las bajas son lógicas (RN12) y un borrado físico
  // no debería ocurrir nunca.
  jurisdiction             Jurisdiction     @relation(fields: [jurisdictionId], references: [jurisdictionId], onDelete: Restrict)
  client                   Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  responsibleLawyer        Lawyer           @relation("CaseResponsibleLawyer", fields: [responsibleLawyerId], references: [id], onDelete: Restrict)
  createdBy                User             @relation("CaseCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  currentState             ProceduralState? @relation("CaseCurrentState", fields: [currentStateId], references: [stateId], onDelete: Restrict)
  currentProceduralAct     ProceduralAct?   @relation("CaseCurrentAct", fields: [currentProceduralActId], references: [id], onDelete: Restrict)
  cloudFolder              CloudFolder?     @relation(fields: [cloudFolderId], references: [cloudFolderId], onDelete: Restrict)
  prescriptionRegisteredBy User?            @relation("CasePrescriptionRegisteredBy", fields: [prescriptionRegisteredByUserId], references: [id], onDelete: Restrict)
  deactivatedBy            User?            @relation("CaseDeactivatedBy", fields: [deactivatedByUserId], references: [id], onDelete: Restrict)

  proceduralActs    ProceduralAct[]        @relation("CaseProceduralActs")
  offenses          Offense[]
  interruptiveActs  InterruptiveAct[]
  templateCopies    DocumentTemplateCopy[]
  sentNotifications SentNotification[]
  caseFiles         CaseFile[]

  @@index([jurisdictionId])
  @@index([clientId])
  @@index([responsibleLawyerId])
  @@index([currentStateId])
  @@map("cases")
}

// Hechos de una causa: cada calificación legal asignada a la causa, con
// su fecha del hecho y su fecha de prescripción. La PK compuesta impide
// repetir una calificación en la misma causa. Puede no haber ninguno,
// incluso en CRIMINAL (D-33); que solo CRIMINAL los tenga se valida en
// el dominio.
model Offense {
  caseId               Int      @map("case_id")
  legalQualificationId Int      @map("legal_qualification_id")
  offenseDate          DateTime @map("offense_date") @db.Date
  // Fecha en que prescribe este hecho: inicio del cómputo + los
  // prescription_months de la calificación. Al registrar la causa, el
  // inicio es offense_date. Al registrar un acto interruptivo que pasa a
  // ser el más reciente de la causa, se actualiza con su fecha como
  // inicio (RN8, D-49); uno con fecha anterior al vigente no la cambia.
  prescriptionDate     DateTime @map("prescription_date") @db.Date

  case               Case               @relation(fields: [caseId], references: [id], onDelete: Restrict)
  legalQualification LegalQualification @relation(fields: [legalQualificationId], references: [id], onDelete: Restrict)

  @@id([caseId, legalQualificationId])
  @@index([legalQualificationId])
  @@map("offenses")
}

// El acto procesal es la línea de tiempo de la causa: no hay tabla de
// historial aparte. Solo lo registra el abogado responsable de la causa
// (D-30); esa regla vive en el caso de uso, no en la base.
model ProceduralAct {
  id     Int @id @default(autoincrement())
  caseId Int @map("case_id")

  // Estado de la tabla o estado escrito a mano. CHECK manual:
  //   num_nonnulls(procedural_state_id, custom_state) = 1
  proceduralStateId Int?    @map("procedural_state_id")
  customState       String? @map("custom_state") @db.VarChar(255)

  actDate          DateTime  @map("act_date") @db.Date
  // Solo ADMINISTRATIVE (RN6). CHECK manual: >= act_date.
  notificationDate DateTime? @map("notification_date") @db.Date
  notes            String?   @db.VarChar(2000)
  // Si el acto interrumpe la prescripción. La mayoría lo hace, por eso
  // vale `true` por defecto; el abogado lo desmarca en los que no.
  isInterruptive   Boolean   @default(true) @map("is_interruptive")

  // Copia del plazo de la tabla al momento del registro: modificar el
  // estado procesal después no altera este vencimiento.
  deadlineTimeLimitDays   Int       @map("deadline_time_limit_days")
  deadlineDayType         DayType   @map("deadline_day_type")
  // notification_date en ADMINISTRATIVE; act_date en los demás fueros.
  deadlineCountsFrom      DateTime  @map("deadline_counts_from") @db.Date
  // Lo que resulta de la tabla. NULL si el estado no abre plazo.
  deadlineComputedDueDate DateTime? @map("deadline_computed_due_date") @db.Date
  // Ajuste manual del abogado. CHECK manual: >= deadline_counts_from.
  // Vencimiento vigente = COALESCE(manual, computed), calculado al leer.
  deadlineManualDueDate   DateTime? @map("deadline_manual_due_date") @db.Date

  registeredByUserId   Int      @map("registered_by_user_id")
  // Copia del responsable al momento del registro: si la causa cambia de
  // responsable, el historial conserva quién lo era.
  registeredByLawyerId Int      @map("registered_by_lawyer_id")
  registeredAt         DateTime @default(now()) @map("registered_at") @db.Timestamptz(6)

  // Última modificación (HU28, D-98). NULL las dos si el acto nunca se
  // modificó; `registered_*` no cambia al modificar. CHECK manual
  // `ck_procedural_acts_last_modified_coherent`.
  lastModifiedByUserId Int?      @map("last_modified_by_user_id")
  lastModifiedAt       DateTime? @map("last_modified_at") @db.Timestamptz(6)

  case               Case             @relation("CaseProceduralActs", fields: [caseId], references: [id], onDelete: Restrict)
  currentOfCase      Case?            @relation("CaseCurrentAct")
  proceduralState    ProceduralState? @relation(fields: [proceduralStateId], references: [stateId], onDelete: Restrict)
  registeredBy       User             @relation("ProceduralActRegisteredBy", fields: [registeredByUserId], references: [id], onDelete: Restrict)
  registeredByLawyer Lawyer           @relation("ProceduralActRegisteredByLawyer", fields: [registeredByLawyerId], references: [id], onDelete: Restrict)
  lastModifiedBy     User?            @relation("ProceduralActLastModifiedBy", fields: [lastModifiedByUserId], references: [id], onDelete: Restrict)

  // Avisos de vencimiento que el proceso diario envió por este acto.
  sentNotifications SentNotification[]

  @@index([caseId, actDate(sort: Desc), id(sort: Desc)])
  @@index([proceduralStateId])
  @@map("procedural_acts")
}

// Acto interruptivo (HU31): reinicia el cómputo de la prescripción de
// todas las calificaciones de la causa, desde su fecha (RN8, D-49). No
// mueve el estado ni abre un plazo, por eso es un recurso propio y no un
// acto procesal (D-48). Solo en CRIMINAL y solo lo registra el abogado
// responsable (D-50); las dos reglas viven en el caso de uso.
model InterruptiveAct {
  id      Int      @id @default(autoincrement())
  caseId  Int      @map("case_id")
  // Texto libre: "Citación a juicio", "Indagatoria". No hay catálogo.
  name    String   @db.VarChar(255)
  actDate DateTime @map("act_date") @db.Date
  notes   String?  @db.VarChar(2000)

  registeredByUserId   Int      @map("registered_by_user_id")
  // Copia del responsable al momento del registro, como en los actos
  // procesales.
  registeredByLawyerId Int      @map("registered_by_lawyer_id")
  registeredAt         DateTime @default(now()) @map("registered_at") @db.Timestamptz(6)

  case               Case   @relation(fields: [caseId], references: [id], onDelete: Restrict)
  registeredBy       User   @relation("InterruptiveActRegisteredBy", fields: [registeredByUserId], references: [id], onDelete: Restrict)
  registeredByLawyer Lawyer @relation("InterruptiveActRegisteredByLawyer", fields: [registeredByLawyerId], references: [id], onDelete: Restrict)

  @@index([caseId, actDate(sort: Desc), id(sort: Desc)])
  @@map("interruptive_acts")
}

// ─────────────────────────────────────────────────────────────
// documents — Carpetas, modelos formales y expedientes en la nube
// (HU25, HU34, HU35, HU39, HU40; ADR-003)
// ─────────────────────────────────────────────────────────────
// La base no depende del proveedor de almacenamiento: nada se nombra por
// la tecnología. Todo se referencia por el identificador que la nube le
// da a cada carpeta o archivo, nunca por nombre ni por ruta.

enum CloudFolderKind {
  MAIN // VZ Causas, la raíz
  TEMPLATES // Modelos formales
  ROOT_CASES // Causas
  LAWYER // Causas/{abogado}
  JURISDICTION // Modelos formales/{fuero} o Causas/{abogado}/{fuero}
  CASE // Causas/{abogado}/{fuero}/{carátula}

  @@map("cloud_folder_kind")
}

enum CaseFolderStatus {
  CREATED
  PENDING
  CREATING
  ERROR

  @@map("case_folder_status")
}

enum TemplateCopyStatus {
  COPIED
  PENDING

  @@map("template_copy_status")
}

// Todas las carpetas que crea el sistema, en una sola tabla. La clave
// primaria es el identificador de la carpeta en la nube.
//
//   VZ Causas                    MAIN
//   ├── Modelos formales         TEMPLATES
//   │   └── {fuero}              JURISDICTION (lawyer_id NULL)
//   └── Causas                   ROOT_CASES
//       └── {abogado}            LAWYER
//           └── {fuero}          JURISDICTION (lawyer_id con valor)
//               └── {carátula}   CASE
//
// Las dos carpetas de fuero se distinguen por `lawyer_id` y por su padre.
// La ruta que muestra la API (`folder.path`) se arma recorriendo los
// padres; no se guarda.
//
// Las carpetas siguen a la causa (D-104, Sprint 4; reemplaza a D-61): la
// CASE se renombra si cambia la carátula y se mueve a la JURISDICTION del
// nuevo responsable si cambia el responsable (cambian `name`,
// `parent_cloud_folder_id` y `lawyer_id` en la misma actualización), y la
// LAWYER se renombra si cambia el nombre del abogado. La fila refleja el
// nombre y la ubicación REALES en la nube: se actualiza solo cuando la
// nube confirmó el cambio, y el proceso diario corrige lo que quedó
// desfasado comparando lo esperado con lo guardado. La baja de la causa
// no toca su carpeta.
model CloudFolder {
  cloudFolderId       String          @id @map("cloud_folder_id") @db.VarChar(128)
  kind                CloudFolderKind
  name                String          @db.VarChar(255)
  url                 String          @db.VarChar(512)
  // NULL solo en MAIN.
  parentCloudFolderId String?         @map("parent_cloud_folder_id") @db.VarChar(128)
  // En LAWYER, en la JURISDICTION de causas y en CASE.
  lawyerId            Int?            @map("lawyer_id")
  // En JURISDICTION y en CASE.
  jurisdictionId      Int?            @map("jurisdiction_id")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  parent       CloudFolder?  @relation("CloudFolderTree", fields: [parentCloudFolderId], references: [cloudFolderId], onDelete: Restrict)
  children     CloudFolder[] @relation("CloudFolderTree")
  lawyer       Lawyer?       @relation(fields: [lawyerId], references: [id], onDelete: Restrict)
  jurisdiction Jurisdiction? @relation(fields: [jurisdictionId], references: [jurisdictionId], onDelete: Restrict)

  // Causa de la carpeta, solo en las de tipo CASE.
  case              Case?
  documentTemplates DocumentTemplate[]

  @@index([parentCloudFolderId])
  @@map("cloud_folders")
}

// Modelo formal (HU34, HU35): un solo registro y un solo archivo aunque
// aplique a varios fueros (D-55). Vive en la JURISDICTION de modelos de
// su fuero o, si es de varios fueros, en TEMPLATES. Nombre único sin
// distinguir mayúsculas (D-71), pendiente del SQL manual.
model DocumentTemplate {
  id                  Int      @id @default(autoincrement())
  name                String   @db.VarChar(150)
  fileName            String   @map("file_name") @db.VarChar(255)
  cloudFileId         String   @unique @map("cloud_file_id") @db.VarChar(128)
  cloudFolderId       String   @map("cloud_folder_id") @db.VarChar(128)
  // Si se copia a la carpeta de las causas nuevas de sus fueros (HU40).
  copyToNewCases      Boolean  @default(true) @map("copy_to_new_cases")
  lastVersionAt       DateTime @default(now()) @map("last_version_at") @db.Timestamptz(6)
  lastVersionByUserId Int      @map("last_version_by_user_id")
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cloudFolder   CloudFolder @relation(fields: [cloudFolderId], references: [cloudFolderId], onDelete: Restrict)
  lastVersionBy User        @relation(fields: [lastVersionByUserId], references: [id], onDelete: Restrict)

  jurisdictions DocumentTemplateJurisdiction[]
  copies        DocumentTemplateCopy[]

  @@map("document_templates")
}

// Fueros a los que aplica cada modelo formal (D-55).
model DocumentTemplateJurisdiction {
  templateId     Int @map("template_id")
  jurisdictionId Int @map("jurisdiction_id")

  template     DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  jurisdiction Jurisdiction     @relation(fields: [jurisdictionId], references: [jurisdictionId], onDelete: Restrict)

  @@id([templateId, jurisdictionId])
  @@index([jurisdictionId])
  @@map("document_template_jurisdictions")
}

// Qué modelo se copió (o falta copiar) a la carpeta de qué causa (HU40).
// La fila nace PENDING al pedir la copia, aunque la carpeta todavía no
// exista, y pasa a COPIED con el identificador de la copia. De acá salen
// `templatesCopied`, `templatesPending` y `usageCount`. La copia es
// independiente del modelo: cambios posteriores no la tocan.
model DocumentTemplateCopy {
  caseId      Int                @map("case_id")
  templateId  Int                @map("template_id")
  status      TemplateCopyStatus
  // NULL mientras está PENDING.
  cloudFileId String?            @unique @map("cloud_file_id") @db.VarChar(128)
  copiedAt    DateTime?          @map("copied_at") @db.Timestamptz(6)

  case     Case             @relation(fields: [caseId], references: [id], onDelete: Restrict)
  template DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@id([caseId, templateId])
  @@index([templateId])
  @@map("document_template_copies")
}

// Expediente generado por el sistema (HU25, D-102): un PDF guardado en la
// carpeta de la causa. La tabla lleva la numeración de las versiones
// (`version` desde 1, correlativa por causa, nunca se reutiliza aunque el
// archivo se borre en la nube) y permite reconocer qué archivo de la
// carpeta es un expediente (`caseFile` en `GET /cases/{caseId}/documents`
// y CA-25.3). La fila se inserta recién cuando la nube guardó el archivo:
// un fallo no consume el número (CA-25.8). Las partes del expediente no
// se guardan: solo viajan en la respuesta del alta.
model CaseFile {
  id                Int      @id @default(autoincrement())
  caseId            Int      @map("case_id")
  // CHECK manual: >= 1.
  version           Int
  cloudFileId       String   @unique @map("cloud_file_id") @db.VarChar(128)
  // `Expediente_{SAC}_v{n}.pdf` o `Expediente_causa-{id}_v{n}.pdf`, tal
  // como se guardó.
  fileName          String   @map("file_name") @db.VarChar(255)
  // CHECK manual: >= 1.
  pageCount         Int      @map("page_count")
  generatedByUserId Int      @map("generated_by_user_id")
  generatedAt       DateTime @default(now()) @map("generated_at") @db.Timestamptz(6)

  case        Case @relation(fields: [caseId], references: [id], onDelete: Restrict)
  generatedBy User @relation(fields: [generatedByUserId], references: [id], onDelete: Restrict)

  // Dos generaciones simultáneas de la misma causa chocan acá: la segunda
  // reintenta con el número siguiente.
  @@unique([caseId, version])
  @@map("case_files")
}

// Acceso de cada usuario a la carpeta MAIN (D-83). Se comparte con los
// usuarios vigentes con rol LAWYER o SECRETARY y se quita al dejar de
// serlo. `granted` es lo que corresponde; `synced_at` NULL indica que la
// nube todavía no lo refleja y el proceso diario lo reintenta (C-23).
model UserFolderAccess {
  userId            Int       @id @map("user_id")
  email             String    @db.VarChar(255)
  cloudPermissionId String?   @map("cloud_permission_id") @db.VarChar(128)
  granted           Boolean
  syncedAt          DateTime? @map("synced_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_folder_access")
}

// ─────────────────────────────────────────────────────────────
// deadlines — Proceso automático diario (HU30, HU32, HU51, HU52)
// ─────────────────────────────────────────────────────────────

enum DeadlineKind {
  PROCEDURAL_ACT
  HARMFUL_ACT

  @@map("deadline_kind")
}

enum NotificationKind {
  DEADLINE_WARNING
  DEADLINE_DUE_TODAY
  PRESCRIPTION_ALERT
  PRESCRIPTION_EXPIRED

  @@map("notification_kind")
}

// Qué avisó el proceso diario y cuándo, para no repetir un aviso (D-64).
// Un aviso se envía una vez por causa, tipo y fecha de referencia: una
// renovación del acto lesivo o un acto interruptivo cambian esa fecha, y
// entonces se vuelve a avisar.
model SentNotification {
  id              Int              @id @default(autoincrement())
  caseId          Int              @map("case_id")
  kind            NotificationKind
  // Solo en los avisos de vencimiento.
  deadlineKind    DeadlineKind?    @map("deadline_kind")
  // Acto que abrió el plazo avisado, si es de un acto procesal.
  proceduralActId Int?             @map("procedural_act_id")
  // Vencimiento avisado, o fecha de prescripción avisada.
  referenceDate   DateTime         @map("reference_date") @db.Date
  recipientLawyerId Int? @map("recipient_lawyer_id")
  sentAt          DateTime         @default(now()) @map("sent_at") @db.Timestamptz(6)

  case          Case           @relation(fields: [caseId], references: [id], onDelete: Restrict)
  proceduralAct ProceduralAct? @relation(fields: [proceduralActId], references: [id], onDelete: Restrict)
  recipientLawyer Lawyer? @relation(fields: [recipientLawyerId], references: [id], onDelete: Restrict)

  // Un aviso una sola vez. El índice real es NULLS NOT DISTINCT (lo crea
  // a mano `sprint3_manual_constraints`); se declara acá con su nombre
  // para que Prisma no lo vea como deriva.
  @@unique([caseId, kind, deadlineKind, referenceDate, recipientLawyerId], map: "sent_notifications_once_key")
  @@map("sent_notifications")
}

// Una corrida del proceso diario por fecha (hora de Córdoba), para que no
// corra dos veces el mismo día.
model DailyJobRun {
  runDate    DateTime  @id @map("run_date") @db.Date
  startedAt  DateTime  @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  error      String?

  @@map("daily_job_runs")
}

// ─────────────────────────────────────────────────────────────
// audit — Auditoría de negocio (transversal; AUDITORIA_Y_TRAZABILIDAD.md)
// ─────────────────────────────────────────────────────────────
// Quién hizo qué, sobre qué entidad y cuándo (Ley 25.326, RN12; CA-14.5,
// CA-19.15, CA-21.3). La escriben los casos de uso de cualquier
// subsistema a través de `AuditTrailPort` (§3), nunca un interceptor
// HTTP. No tiene endpoint de consulta.
//
// Es de solo alta: un trigger manual (`trg_audit_log_append_only`)
// rechaza UPDATE, DELETE y TRUNCATE. Solo admite borrar dentro de una
// transacción que active `vzcausas.audit_purge` (limpieza de los tests).
//
// `metadata` NUNCA lleva datos sensibles ni contenido de la causa (§4):
// identificadores y los NOMBRES de los campos que cambiaron, no sus
// valores. Sin `onDelete: Cascade` hacia `users`: un usuario con
// auditoría no se borra físicamente (RN12).
model AuditLog {
  id            Int      @id @default(autoincrement())
  // NULL solo si no hay un usuario detrás: el proceso automático diario.
  actorUserId   Int?     @map("actor_user_id")
  // Entidad y verbo separados por punto: `case.updated`,
  // `case.deactivated`, `lawyer.updated`.
  action        String   @db.VarChar(100)
  // `Case`, `Lawyer`, `ProceduralAct`…
  entityType    String   @map("entity_type") @db.VarChar(50)
  // Texto, para admitir claves numéricas y de la nube.
  entityId      String   @map("entity_id") @db.VarChar(128)
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  // CHECK manual: objeto JSON.
  metadata      Json?    @db.JsonB
  // Id de correlación de la petición (`correlation-id.middleware`, hasta
  // 128 caracteres), para cruzar con el log técnico.
  correlationId String?  @map("correlation_id") @db.VarChar(128)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("audit_log")
}

// ─────────────────────────────────────────────────────────────
// SQL manual — lo que Prisma no expresa
// ─────────────────────────────────────────────────────────────
// Va en una migración creada con `migrate dev --create-only`. Si una
// migración generada después trae un DROP de cualquiera de estos
// objetos, hay que quitarlo a mano.
//
// Índices únicos parciales:
//   users                (lawyer_id) WHERE active AND lawyer_id IS NOT NULL   -- ya existe
//   procedural_states    (jurisdiction_id, lower(name)) WHERE is_active
//   procedural_states    (jurisdiction_id) WHERE is_initial
//   legal_qualifications (lower(name)) WHERE active
//   clients              (dni) WHERE active
//   -- Sprint 3 (migración sprint3_manual_constraints)
//   procedural_states    (jurisdiction_id) WHERE is_prescribed
//   cloud_folders        (kind) WHERE kind IN ('MAIN', 'TEMPLATES', 'ROOT_CASES')
//   cloud_folders        (lawyer_id) WHERE kind = 'LAWYER'
//   cloud_folders        (lawyer_id, jurisdiction_id) WHERE kind = 'JURISDICTION' AND lawyer_id IS NOT NULL
//   cloud_folders        (jurisdiction_id) WHERE kind = 'JURISDICTION' AND lawyer_id IS NULL
//   document_templates   (lower(name)) WHERE active
//   //   sent_notifications   (case_id, kind, deadline_kind, reference_date, recipient_lawyer_id) NULLS NOT DISTINCT
//   -- Sprint 4 (migración sprint4_manual_constraints)
//   cases                (sac_number) WHERE active AND sac_number IS NOT NULL  -- reemplaza a cases_sac_number_key
//
// CHECK:
//   procedural_states    time_limit_days >= 0
//   procedural_states    (time_limit_days = 0) = (day_type = 'NONE')
//   procedural_states    NOT is_initial OR (NOT terminal AND time_limit_days = 0 AND day_type = 'NONE')
//   legal_qualifications prescription_months >= 1
//   clients              dni ~ '^[0-9]{7,8}$'
//   cases                sac_number IS NULL OR sac_number ~ '^[0-9]{8}$'
//   cases                num_nonnulls(current_state_id, current_custom_state) = 1
//   procedural_acts      num_nonnulls(procedural_state_id, custom_state) = 1
//   procedural_acts      notification_date IS NULL OR notification_date >= act_date
//   procedural_acts      deadline_manual_due_date IS NULL OR deadline_manual_due_date >= deadline_counts_from
//   -- Sprint 3 (migración sprint3_manual_constraints)
//   procedural_states        ck_procedural_states_prescribed_is_terminal
//   cases                    ck_cases_harmful_act_renewal_coherent
//   cases                    ck_cases_harmful_act_renewal_days_positive
//   cases                    ck_cases_harmful_act_term_complete
//   cases                    ck_cases_harmful_act_term_days_positive
//   cases                    ck_cases_harmful_act_term_day_type
//   cases                    ck_cases_folder_created_has_cloud_folder
//   cases                    ck_cases_prescription_declaration_complete
//   cases                    ck_cases_prescription_grounds_need_declaration
//   cloud_folders            ck_cloud_folders_shape_by_kind
//   document_template_copies ck_document_template_copies_copied_has_file
//   sent_notifications       ck_sent_notifications_deadline_kind_coherent
//   sent_notifications       ck_sent_notifications_act_only_for_procedural_deadline
//   daily_job_runs           ck_daily_job_runs_finished_after_started
//   -- Sprint 4 (migración sprint4_manual_constraints)
//   cases                    ck_cases_deactivation_coherent
//   cases                    ck_cases_deactivation_reason_not_blank
//   procedural_acts          ck_procedural_acts_last_modified_coherent
//   procedural_acts          ck_procedural_acts_last_modified_after_registered
//   case_files               ck_case_files_version_positive
//   case_files               ck_case_files_page_count_positive
//   audit_log                ck_audit_log_metadata_is_object
//
// Triggers:
//   -- Sprint 4 (migración sprint4_manual_constraints)
//   audit_log                trg_audit_log_append_only, trg_audit_log_no_truncate
//                            (función audit_log_reject_changes)
