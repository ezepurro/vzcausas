# DB Credentials (PostgreSQL)
POSTGRES_USER=causas-dev
POSTGRES_PASSWORD=causas-dev
POSTGRES_DB=causas-dev

# Backend Env
NODE_ENV=development
PORT=3000

# DATABASE_URL= embedded on runtime by compose

# JWT (D-04, D-06). El refresh token es un valor opaco persistido en base,
# no un JWT (D-05), así que no lleva secreto propio.
JWT_ACCESS_SECRET=59fa75612510c1f164a2b49ef97c1b5e059c22c563ab163b7735f36e15ebe237
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# bcrypt (D-07)
BCRYPT_COST=12

# Cookie de refresh (D-08, Q-06)
COOKIE_REFRESH_NAME=refresh_token
COOKIE_REFRESH_PATH=/api/v1/auth
COOKIE_REFRESH_SAMESITE=Lax
COOKIE_SECURE=false

# CORS y zona horaria del estudio
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
APP_TIMEZONE=America/Argentina/Cordoba

# Bloqueo progresivo por intentos fallidos (Q-03). Dos capas: la primera
# cuenta por usuario + IP (es el bloqueo principal, acotado a la IP para
# que nadie pueda dejar afuera a un abogado de su propia cuenta); la
# segunda cuenta por usuario solo, con umbral alto, como red de
# contención contra el ataque distribuido.
#
# _LADDER es la duración del bloqueo por nivel; el último escalón se
# repite para siempre, así que es el tope. Ver backend/.env.example para
# el detalle de cada variable.
LOGIN_LOCK_THRESHOLD=5
LOGIN_LOCK_WINDOW=15m
LOGIN_LOCK_LADDER=90s,5m,15m,30m,60m
LOGIN_LOCK_USER_THRESHOLD=25
LOGIN_LOCK_USER_WINDOW=1h
LOGIN_LOCK_USER_LADDER=15m

# Inactividad de sesion (CA-1.6): cuanto puede estar una sesion sin
# renovarse antes de que el access token deje de aceptarse. Aproximada,
# no al segundo (ver backend/.env.example para el detalle).
SESSION_INACTIVITY_TTL=30m

# Throttle por IP (Q-03), distinto del bloqueo por cuenta de arriba:
# cuenta pedidos por direccion IP, sin importar a que cuenta apunten.
# Ver backend/.env.example para el detalle de por que hacen falta los
# dos. THROTTLE_DEFAULT_* rige toda la API; THROTTLE_AUTH_* es el
# limite mas estricto, solo para /auth/login y /auth/refresh.
THROTTLE_DEFAULT_LIMIT=300
THROTTLE_DEFAULT_WINDOW=1m
THROTTLE_AUTH_LIMIT=10
THROTTLE_AUTH_WINDOW=1m

# El backend esta detras del proxy de Vite en dev y potencialmente de
# otro balanceador en produccion: hace falta decirle a Express que
# confie en X-Forwarded-For, o el throttle de arriba cuenta a todos los
# usuarios como si fueran uno solo. Ver backend/.env.example.
TRUST_PROXY=1

# Usuario de desarrollo (DevSeedService). Sin estas dos variables no se crea
# ninguno y todo login responde 401. Solo se leen con NODE_ENV=development.
DEV_SEED_USERNAME=admin
DEV_SEED_PASSWORD=admin123

#Frontend Env
VITE_USE_MOCKS=true
VITE_BACKEND_URL=http://backend:3000