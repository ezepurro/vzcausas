{
  /* Los tests (tests/) con las mismas reglas que el código de la app, más los
     tipos de Node que usan Playwright y el setup. Está referenciado desde
     tsconfig.json, así que `npm run build` también chequea los tests. */
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": ["tests", "src"]
}
