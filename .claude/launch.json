{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "5174", "--strictPort"],
      "port": 5174
    },
    {
      "name": "frontend-mocks",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "process.env.VITE_USE_MOCKS='true';require('child_process').spawn('npm',['--prefix','frontend','run','dev','--','--port','5175','--strictPort'],{stdio:'inherit',shell:true,env:process.env}).on('exit',c=>process.exit(c??0))"
      ],
      "port": 5175
    }
  ]
}
